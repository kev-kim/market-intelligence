# ─── Data backend selection ──────────────────────────────────────────────────
# The app's data layer (lib/api.ts) dispatches on this flag:
#   unset / "true"  → in-memory DEMO backend (fully self-contained, no backend)
#   "false"         → real FastAPI client (lib/real-api.ts) at NEXT_PUBLIC_API_URL
#
# NOTE: NEXT_PUBLIC_* vars are inlined at BUILD time, so this is chosen when you
# build, not at runtime. The deployed showcase builds with demo on (the default).
NEXT_PUBLIC_DEMO=true

# Real backend base URL (only used when NEXT_PUBLIC_DEMO=false).
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── Served-under-a-subpath (Multi-Zone) — optional ───────────────────────────
# Set when this app is proxied under a path prefix (e.g. yoursite.com/kci).
# NEXT_PUBLIC_BASE_PATH=/kci
