# ─── Database ────────────────────────────────────────────────────────────────
# Supabase connection string (Transaction mode / direct)
DATABASE_URL=postgresql+psycopg://postgres:password@db.your-project.supabase.co:5432/postgres

# For Alembic (synchronous psycopg driver)
ALEMBIC_DATABASE_URL=postgresql+psycopg://postgres:password@db.your-project.supabase.co:5432/postgres

# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── LLM providers ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...

# ─── External APIs ───────────────────────────────────────────────────────────
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret
DART_API_KEY=your-dart-api-key

# ─── Search ──────────────────────────────────────────────────────────────────
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=your-meilisearch-master-key

# ─── App ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ─── Email (alerts) ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=alerts@your-domain.com
